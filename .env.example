# Application name
APP_NAME=Laravel

# Application environment (local, production, etc.)
APP_ENV=local

# Application encryption key
APP_KEY=

# Enable or disable debug mode
APP_DEBUG=true

# Base URL of the application
APP_URL=http://localhost

# Logging configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database connection settings
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Broadcast driver configuration
BROADCAST_DRIVER=log

# Cache driver configuration
CACHE_DRIVER=file

# Filesystem driver configuration
FILESYSTEM_DRIVER=local

# Queue connection configuration
QUEUE_CONNECTION=sync

# Session driver configuration
SESSION_DRIVER=file

# Session lifetime in minutes
SESSION_LIFETIME=120

# Memcached host configuration
MEMCACHED_HOST=127.0.0.1

# Redis host configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailer configuration
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# Mail sender address
MAIL_FROM_ADDRESS=null

# Mail sender name
MAIL_FROM_NAME="${APP_NAME}"

# AWS access key ID
AWS_ACCESS_KEY_ID=

# AWS secret access key
AWS_SECRET_ACCESS_KEY=

# AWS default region
AWS_DEFAULT_REGION=us-east-1

# AWS bucket name
AWS_BUCKET=

# AWS path style endpoint usage
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher application ID
PUSHER_APP_ID=

# Pusher application key
PUSHER_APP_KEY=

# Pusher application secret
PUSHER_APP_SECRET=

# Pusher application cluster
PUSHER_APP_CLUSTER=mt1

# Pusher application key for Mix
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"

# Pusher application cluster for Mix
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Faker locale configuration
FAKER_LOCALE=id_ID

# Filesystem driver configuration
FILESYSTEM_DRIVER=public
